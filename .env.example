# Copy to `.env` and fill in. Never commit the real `.env`.

# ── FastAPI / backend ──
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_budget_dev

# Shared secret between the Cloudflare Consumer Worker and FastAPI /internal/* routes.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=

# Inbound email hostname decided in Phase 0 (apex vs subdomain of raksimoni.com).
EMAIL_DOMAIN=fintrack.raksimoni.com

# ── Cloudflare R2 (raw .eml storage) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=email-budget-raw

# Encrypts the budgeting-app webhook secret at rest (any high-entropy string).
# Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# ── Observability ──
SENTRY_DSN=

# NOTE: the Cloudflare Workers get their own vars via wrangler (not this file):
#   Email Worker      → INTERNAL_SECRET, FASTAPI_INTERNAL_URL (for edge alias check)
#   Consumer Worker   → INTERNAL_SECRET, FASTAPI_INTERNAL_URL
